  "section_lyrics": {
    "lyric-00": "내 손가락 움켜쥐던 게",
    "lyric-04": "우연일지 모를 \"파파\"에",
    "lyric-13": "뒤뚱뒤뚱\n나에게 온다",
    "lyric-25": "언젠간 네가 커서 이 영상을 보고 함께 이야기 나누는 날까지",
    "lyric-09": "맘껏 기지개를 펴",
    "lyric-03": "그득히 고인 눈물이 첫 인사",
    "lyric-15": "안기려고 팔을 뻗는 너의 숨소리",
    "lyric-28": "또 다른 사랑",
    "lyric-17": "사랑하는 우리 아가 지호야",
    "lyric-18": "지호와\n함께한 지도\n벌써 일년이 되었네",
    "lyric-19": "엄마 아빠에게\n새로운 세상을\n알려줘서",
    "lyric-20": "또 세상에서\n가장 행복한게\n무엇인지 알려줘서",
    "lyric-21": "정말 고마워",
    "lyric-22": "네가 커서 엄마의 품이 전부임을 잊어도",
    "lyric-23": "아빠가 너의 최고의 친구임을 잊어도",
    "lyric-24": "엄마 아빠는 항상 너의 곁에 있단다",
    "lyric-26": "바르고 건강하게 자라길 바래",
    "lyric-27": "<3.6s>바다만큼 우주만큼\n<1.8s>하늘만큼 땅만큼\n<0s>사랑해",
    "lyric-34": "사랑하는 우리 지호 바르고 건강하게 자라렴",
    "after-music": "오늘 지호의 첫번째 생일을 축하해주기 위해\n귀한 시간 내어 와주신 분들께 감사드립니다",
    "lyric-33": "가사 없음",
    "lyric-06b": "한없이 한없이 타들어가고",
    "intro": "2024년 겨울에 찾아온 사랑이",
    "custom-1785681935430": "열달 간의 기다림 끝에",
    "custom-1785682192945": "2025년 8월 7일\n오전 8시 45분\n<3.5s>너를 만났다",
    "gap-37": "엄마 아빠 돌사진인데 누가 지호랑 더 닮았나요?",
    "lyric-14": "조그마한 발바닥이\n너를 옮긴다"
  },
